{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/guard_commit.py\" --claude",
            "timeout": 30,
            "statusMessage": "Checking the commit for ignored files..."
          }
        ]
      }
    ]
  }
}
